# --- Videos originales de Promotores (pesan ~90 MB cada uno; la web usa las versiones de public/media) ---
Intranet/src/assets/PROMOTORES/*.MOV
Intranet/src/assets/PROMOTORES/*.MP4
Intranet/src/assets/PROMOTORES/todo el equipo.png
# Infraestructura: material en bruto (las versiones optimizadas están en galeria/, historias/ y public/media)
Intranet/src/assets/infraestructura/fotos y videos/

# Material fuente audiovisual: no se publica en Git ni se necesita para el build.
# La intranet usa las copias optimizadas que viven en public/media.
Intranet/src/assets/CORPOQUINDIO/MATERIAL/
Intranet/src/assets/mediadores/*.mp4

