# Copia este archivo como .env y completa los valores.
# La intranet es publica: no requiere inicio de sesion.

# --- Mesa de ayuda GLPI ---
VITE_GLPI_URL=https://glpi.tudominio.com/

# --- Redes sociales ---
# No hay tokens ni variables: los enlaces del perfil y de la última publicación de cada red
# los pegan los gestores desde la intranet (Noticias > Redes sociales > Editar redes).

# --- Módulo de Cumpleaños (servidor: server/index.js) ---
# Estas variables las lee el servidor, no el navegador. En Railway van en
# Variables del servicio. En local no hacen falta: se crea gestor / cumple2026.
#
# Usuario gestor inicial (se crea solo la primera vez, si no existe data/users.json).
GESTOR_USER=
GESTOR_PASSWORD=
# Usuario administrador inicial (rol admin: ve también la vista de Administración).
ADMIN_USER=
ADMIN_PASSWORD=
# Firma de las sesiones. Sin ella, reiniciar el servidor cierra las sesiones abiertas.
SESSION_SECRET=
# Base de datos PostgreSQL. En Railway se conecta con el servicio Postgres: DATABASE_URL=${{Postgres.DATABASE_URL}}.
# Sin esta variable (desarrollo local) los datos se guardan en archivos dentro de DATA_DIR.
DATABASE_URL=
# Opcionales: PGSSL=true si la base exige SSL; PG_POOL=10 conexiones máximas.
#
# Dirección pública del sitio (enlace canónico, imagen social y sitemap). Si no se define, se toma del host.
SITE_URL=
#
# Carpeta donde se guardan personas, usuarios y fotos. En Railway monta un
# volumen (por ejemplo en /data) y apunta aquí, o se pierden en cada despliegue.
DATA_DIR=
#
# Desarrollo: ejecuta en dos terminales `npm run dev:api` y `npm run dev`.

# --- Módulo de Solicitudes: correos y GLPI (servidor) ---
# Mientras MAIL_MODE no sea exactamente "produccion", TODOS los correos van a EMAIL_PRUEBAS.
MAIL_MODE=pruebas
EMAIL_PRUEBAS=analistapromotres@gstionyservicios.com.co
EMAIL_PRODUCCION=gerenciaadmin@gestionyservicios.com.co
# Préstamo de equipos en producción (por defecto, el mismo EMAIL_PRODUCCION).
EMAIL_PRESTAMOS=
URL_GLPI=https://glpi.gestionyservicios.com.co/
#
# Servidor de correo (SMTP). Sin SMTP_HOST no se envía nada: cada correo, con su
# Excel adjunto, se guarda como .eml en DATA_DIR/outbox para revisarlo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Intranet Gestión y Servicios <no-responder@gestionyservicios.com.co>

# --- Panel de TI (rol «ti») ---
# Usuario de TI inicial (se crea solo la primera vez, si no existe data/users.json). En local: ti / ti12345.
TI_USER=
TI_PASSWORD=
# Destinatario del resumen diario de alertas (líneas por recargar y correos inactivos) en producción.
EMAIL_TI=
