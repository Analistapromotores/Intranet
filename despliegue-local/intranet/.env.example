# Copiar a .env (en esta misma carpeta) y completar. El .env nunca se versiona.
# NODE_ENV, PORT, TRUST_PROXY, DATA_DIR y DATABASE_URL los fija docker-compose.yml: no ponerlos aquí.

# --- Base de datos (PostgreSQL interno, contenedor intranet-db) ---
POSTGRES_PASSWORD=

# --- Sitio ---
SITE_URL=https://intranet.gestionyservicios.com.co
URL_GLPI=https://glpi.gestionyservicios.com.co/

# --- Usuarios iniciales (solo se crean la primera vez) ---
GESTOR_USER=
GESTOR_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=
TI_USER=
TI_PASSWORD=
# Firma de las sesiones. Sin ella, reiniciar el contenedor cierra las sesiones abiertas.
# Generar con:  openssl rand -hex 32
SESSION_SECRET=

# --- Correo ---
# Mientras MAIL_MODE no sea exactamente "produccion", TODOS los correos van a EMAIL_PRUEBAS.
MAIL_MODE=pruebas
EMAIL_PRUEBAS=analistapromotores@gestionyservicios.com.co
EMAIL_PRODUCCION=gerenciaadmin@gestionyservicios.com.co
EMAIL_PRESTAMOS=
# Talento Humano: incapacidades, licencias y ausentismo (con anexos). Por defecto, incapacidadesgys@gestionyservicios.com.co.
EMAIL_INCAPACIDADES=
EMAIL_TI=
MAIL_FROM=Intranet Gestión y Servicios <no-responder@gestionyservicios.com.co>

# Opcional: registrar las solicitudes en Google Sheets en lugar de enviar correo (usa GOOGLE_SERVICE_ACCOUNT_JSON).
# Compartir la hoja como «Editor» con el client_email de la cuenta y pegar su id (lo que va entre /d/ y /edit).
SHEET_ID=

# Gmail con cuenta de servicio (recomendado). El JSON completo en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_SENDER=

# O SMTP. Sin SMTP_HOST (ni Gmail) los correos se guardan como .eml en /data/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Opcional: conexiones máximas al pool de PostgreSQL.
# PG_POOL=10
