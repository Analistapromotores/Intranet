# Copiar a .env y ajustar. NGINX_IMAGE y NGINX_CLIENT_MAX_BODY_SIZE:
# usar los mismos valores que hoy tiene el .env de GLPI.
NGINX_IMAGE=nginx:alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=100M

GLPI_DOMAIN=glpi.gestionyservicios.com.co
INTRANET_DOMAIN=intranet.gestionyservicios.com.co
